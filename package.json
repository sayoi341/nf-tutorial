{
  "name": "mf-tutorial",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "pnpm --parallel --filter \"@mf-tutorial/*\" run start",
    "start:shell": "pnpm --filter @mf-tutorial/shell start",
    "start:mfe1": "pnpm --filter @mf-tutorial/mfe1 start",
    "build": "pnpm --filter \"@mf-tutorial/*\" run build",
    "watch": "pnpm --parallel --filter \"@mf-tutorial/*\" run watch",
    "test": "pnpm --filter \"@mf-tutorial/*\" run test"
  },
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "devDependencies": {
    "@angular-architects/native-federation": "^22.2.5",
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0",
    "@softarc/native-federation-orchestrator": "^4.10.0"
  }
}
