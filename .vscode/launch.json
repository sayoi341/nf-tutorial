  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug shell + mfe1",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "pnpm: start both",
      "url": "http://localhost:4200/flights",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Debug shell",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "pnpm: start shell",
      "url": "http://localhost:4200/",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Debug mfe1",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "pnpm: start mfe1",
      "url": "http://localhost:4201/",
      "webRoot": "${workspaceFolder}"
    }
  ]
}
