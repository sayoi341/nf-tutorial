{
  // For more information, visit: https://go.microsoft.com/fwlink/?LinkId=733558
  "version": "2.0.0",
  "tasks": [
    {
      "label": "pnpm: start shell",
      "type": "shell",
      "command": "pnpm",
      "args": ["--filter", "@mf-tutorial/shell", "start"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "Changes detected"
          },
          "endsPattern": {
            "regexp": "Local:.*http://localhost:4200/"
          }
        }
      }
    },
    {
      "label": "pnpm: start mfe1",
      "type": "shell",
      "command": "pnpm",
      "args": ["--filter", "@mf-tutorial/mfe1", "start"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "Changes detected"
          },
          "endsPattern": {
            "regexp": "Local:.*http://localhost:4201/"
          }
        }
      }
    },
    {
      "label": "pnpm: start both",
      "dependsOn": ["pnpm: start shell", "pnpm: start mfe1"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
